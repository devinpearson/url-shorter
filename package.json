{
  "name": "club-links",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:backend": "tsc --project backend/tsconfig.json",
    "preview": "vite preview",
    "backend:dev": "npm run build:backend && node backend/dist/index.js",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "tsx backend/src/scripts/migrate.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc -b && tsc --noEmit --project backend/tsconfig.json && tsc --noEmit --project tsconfig.test.json",
    "knip": "knip",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "serve:test": "bash scripts/serve-test.sh",
    "verify:lighthouse": "vite build && npx --yes @lhci/cli@0.16.0 autorun",
    "verify": "npm run check && npm run typecheck && npm run knip && npm run lint:md && npm run test:coverage && npm run test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "axios": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.523.0",
    "passport": "^0.7.0",
    "passport-auth0": "^1.4.4",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.0.4",
    "@types/passport": "^1.0.17",
    "@types/passport-auth0": "^1.0.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "knip": "^6.44.2",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.0",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  },
  "description": "Short links for Toastmasters clubs (toast.li)",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched",
    "*.md": "markdownlint-cli2"
  }
}
