# Values shown are for local development. Production (https://toast.li) values are in the comments.

# MongoDB connection string
MONGO_URI=mongodb+srv://username:password@db-mongodb.mongo.ondigitalocean.com

# Session secret for express-session (required; use a long random string in production)
SESSION_SECRET=your-session-secrets

# Auth0 credentials
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DOMAIN=
# Production: https://toast.li/api/auth/callback
AUTH0_CALLBACK_URL=http://localhost:5001/api/auth/callback

# Frontend origin, used for redirects after login/logout.
# Production: https://toast.li
ORIGIN=http://localhost:5173

# Contact form email via Resend (optional: without a key, messages are only saved to MongoDB).
# The sender's domain must be verified in Resend, e.g. RESEND_FROM_EMAIL=hello@toast.li
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_RECIPIENT_EMAIL=
