# Values shown are for local development. Production (https://toast.li) values are in the comments.

# Postgres connection string. For local development, `npm run db:up` starts this database
# (docker-compose.yml). Production: your managed or server Postgres, with ?sslmode=require
# if it needs TLS.
DATABASE_URL=postgres://club_links:club_links_development_only@localhost:5434/club_links

# Session secret for express-session (required; use a long random string in production)
SESSION_SECRET=your-session-secrets

# Auth0 credentials
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DOMAIN=
# Production: https://toast.li/api/auth/callback
AUTH0_CALLBACK_URL=http://localhost:5001/api/auth/callback

# Frontend origin, used for redirects after login/logout.
# Production: https://toast.li
ORIGIN=http://localhost:5173

# Contact form email via Resend (optional: without a key, messages are only saved to the database).
# The sender's domain must be verified in Resend, e.g. RESEND_FROM_EMAIL=hello@toast.li
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_RECIPIENT_EMAIL=
