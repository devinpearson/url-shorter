{
  "ci": {
    "collect": {
      "startServerCommand": "npm run serve:test -- --port 5102",
      "startServerReadyPattern": "Local:",
      "startServerReadyTimeout": 180000,
      "url": [
        "http://127.0.0.1:5102/",
        "http://127.0.0.1:5102/about",
        "http://127.0.0.1:5102/contact",
        "http://127.0.0.1:5102/terms",
        "http://127.0.0.1:5102/login"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
